# 灵珠智能助手第一版环境变量模板
# 使用方法：复制为项目根目录 .env，填写需要启用的值，然后重启后端。
# .env 文件属于本机密钥配置，不要提交到代码仓库。

# --- 应用与数据库 ---
# true 时强制使用体验模式；false 时按各模型的密钥状态调用真实模型。
DEMO_MODE=false
# PostgreSQL 默认容器映射到本机 5432；修改用户名、密码和数据库名为自己的值。
DATABASE_URL=postgresql+psycopg://PJC:CHANGE_ME@127.0.0.1:5432/Lingzhu
# 日志等级：DEBUG、INFO、WARNING、ERROR。
LOG_LEVEL=INFO
# 登录 Cookie 在 HTTPS 下自动启用 Secure；反向代理部署时也可显式设为 true。
AUTH_COOKIE_SECURE=
# 前后端跨源部署时填写前端完整 Origin，多个地址用逗号分隔。
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

# --- 默认文本模型（智能体对话使用；普通改写可在页面单独选择模型） ---
# 可选 deepseek、qwen、doubao、openai。
LLM_PROVIDER=deepseek
# 当前默认模型。可填 deepseek-v4-flash、qwen3.7-plus 或 doubao-2.1-pro。
LLM_MODEL=deepseek-v4-flash

# DeepSeek（深度求索）文本模型
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Qwen / DashScope（通义千问 / 阿里云百炼）文本模型
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Doubao / Volcano Ark（豆包 / 火山方舟）文本模型
# 在火山方舟控制台创建模型接入点后，把 API Key 和接入点 ID 填到下面。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 指向豆包 2.1 Pro 的火山方舟接入点 ID，通常以 ep- 开头；这是启用豆包选项的必填项。
DOUBAO_MODEL=

# OpenAI（开放人工智能）兼容接口，可选；用于接入其他兼容服务。
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- 火山方舟即梦图片生成 ---
# IMAGE_API_KEY 留空时复用上面的 ARK_API_KEY；IMAGE_BASE_URL 留空时复用 ARK_BASE_URL。
# IMAGE_BASE_URL 可填写 API 根地址，也可填写完整的 /images/generations 地址。
# 默认 2K 分辨率、16:9 横向构图；每次调用处理一个分镜并返回一张图片。
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=doubao-seedream-5-0-flash-260915

# --- 视频生成（第一版尚未接真实视频服务，以下为预留配置） ---
VIDEO_PROVIDER=
VIDEO_API_KEY=
VIDEO_BASE_URL=
VIDEO_MODEL=

# --- 后台队列（Celery 使用 Redis 作为任务代理） ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
REDIS_URL=redis://127.0.0.1:6379/0
JOB_MAX_ATTEMPTS=5
JOB_HEARTBEAT_SECONDS=30
JOB_STALE_SECONDS=180
JOB_OUTBOX_POLL_SECONDS=10
JOB_OUTBOX_LOCK_SECONDS=120

# --- 智能体对话上下文预算（估算值；不含完整文案正文的历史重复） ---
AGENT_INPUT_TOKEN_BUDGET=16000
AGENT_SUMMARY_TRIGGER_RATIO=0.75
AGENT_RECENT_MESSAGE_COUNT=8

# --- 可选 S3/OSS：配置后导出时会发布图片和剪映时间线 ---
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_PUBLIC_BASE_URL=
JIANYING_HELPER_URL=https://ts.fyshark.com/#/cozeToJianyin
# 本机剪映草稿目录；留空时自动使用当前 Windows 用户的默认目录。
# 云端部署时应由本地导出端读取导出包并写入本机。
JIANYING_DRAFT_DIR=
# local: Windows backend writes a local draft; package: queue an export for download/import.
JIANYING_EXPORT_MODE=local
